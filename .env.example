# FastAPI backend runs on :8000 (uvicorn). Vite proxies /api -> :8000.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/order_ocr
# Tables (invoice_templates, extraction_logs, extraction_reviews) are created
# automatically on backend startup.

# Primary AI vision provider (used when the local OCR engine output is weak).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Backup AI vision provider, used when Claude is unavailable or fails.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
