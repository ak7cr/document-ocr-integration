PORT=3001
# Required to store reusable templates and extraction history. Apply db/schema.sql first.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/order_ocr

# Optional: the primary AI provider, used for PDF vision/OCR plus structured extraction.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Optional: Gemini 3 Pro fallback when Claude is unavailable or fails.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview
